{%- if mode == "local" -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% endif -%}
<title>EDGAR-SENTINEL MVP</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="Course prototype: do clusters of insider purchases predict stock returns? Pilot sample 2006–2011, survivors only.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&amp;family=IBM+Plex+Sans:wght@400;500;600;700&amp;display=swap">
<style>{{ css|safe }}</style>
{% if mode == "local" %}</head>
<body>
{% endif -%}
{% macro banner(text) -%}
<div class="banner" role="note">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4"/><path d="M12 17.5v.01"/></svg>
  <span><strong>{{ c.meta.label }}.</strong> {{ text }}</span>
</div>
{%- endmacro %}
{% macro signed(x, digits=1) -%}
<span class="{{ 'pos' if x is not none and x > 0 else ('neg' if x is not none and x < 0 else '') }}">{{ x|pct(digits) }}</span>
{%- endmacro %}
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="#overview" data-tab="overview" aria-label="EDGAR-SENTINEL home">
      <svg class="brand-mark" viewBox="0 0 26 26" aria-hidden="true">
        <rect x="1" y="1" width="24" height="24" rx="6" fill="var(--ink)"/>
        <path d="M6 17.5 10.5 12l3.2 3.2L20 8" fill="none" stroke="var(--surface)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="20" cy="8" r="2" fill="var(--s2)"/>
      </svg>
      <span class="brand-name">EDGAR-SENTINEL</span>
      <span class="badge">MVP</span>
    </a>
    <nav class="tabs" role="tablist" aria-label="Sections">
      {% for id, name in [("overview","Overview"),("findings","Findings"),("model","Model"),("screener","Latest clusters"),("company","Company lookup"),("method","Method & limits")] %}
      <button class="tab" role="tab" id="tab-{{ id }}" data-tab="{{ id }}" aria-controls="{{ id }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ name }}</button>
      {% endfor %}
    </nav>
    <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch between light and dark theme">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
    </button>
  </div>
</header>

<main id="main" class="wrap">

<!-- ============================== OVERVIEW ============================== -->
<section id="overview" class="panel" role="tabpanel" aria-labelledby="tab-overview">
  <div class="panel-head">
    <p class="eyebrow">Capstone prototype · SEC Form 4 insider filings · 2006–2026</p>
    <h1>Do clusters of insider purchases predict stock returns?</h1>
    <p class="lead">When two or more of a company's insiders buy its shares on the open market within two weeks, does the stock beat the market afterwards, once trading costs are paid? EDGAR-SENTINEL reads every SEC Form 4 filing since 2006 to find these clusters, measures what happened next and scores the newest ones.</p>
  </div>
  {{ banner("Returns are measured only for 2006–2011 events, at companies that still trade today. The 2012–2026 study stays sealed until its plan is pre-registered.") }}
  <div class="answer">
    <p class="eyebrow">Pilot answer</p>
    <p class="verdict">{{ v.verdict }}</p>
    <p>{{ v.verdict_detail }}</p>
  </div>
  <div class="kpis">
    <div class="kpi">
      <span class="kpi-label"><i class="dot" style="background:var(--s1)"></i>Clusters · 3-month return vs small caps, after costs</span>
      <span class="kpi-value">{{ signed(v.a.net) }}</span>
      <span class="kpi-sub">95% band {{ v.a.lo|pct }} to {{ v.a.hi|pct }} · {{ v.a.n|num }} events</span>
    </div>
    <div class="kpi">
      <span class="kpi-label"><i class="dot" style="background:var(--s2)"></i>Solo CEO/CFO buys · same measure</span>
      <span class="kpi-value">{{ signed(v.b.net) }}</span>
      <span class="kpi-sub">95% band {{ v.b.lo|pct }} to {{ v.b.hi|pct }} · {{ v.b.n|num }} events</span>
    </div>
    <div class="kpi">
      <span class="kpi-label">Model ranking quality, 2011 test (0.5 = chance)</span>
      <span class="kpi-value">{{ "%.2f"|format(v.m.auc) }}</span>
      <span class="kpi-sub">Market-data-only model: {{ "%.2f"|format(v.m.base_auc) }}</span>
    </div>
    <div class="kpi">
      <span class="kpi-label">New insider events, Jul–Sep 2026</span>
      <span class="kpi-value">{{ v.recent.total }}</span>
      <span class="kpi-sub">{{ v.recent.a }} clusters · {{ v.recent.b1 }} solo CEO/CFO · {{ v.recent.scored }} scored</span>
    </div>
  </div>
  <div class="grid wide-left">
    <article class="card">
      <div class="card-head"><div>
        <h2>From 4.5 million filings to {{ v.used_total|num }} tradable pilot events</h2>
        <p class="card-sub">Each step keeps only what the next one needs.</p>
      </div></div>
      <ol class="funnel">
        {% for f in v.funnel %}
        <li class="{{ 'final' if loop.last else '' }}">
          <div class="stage"><strong>{{ f.stage }}</strong><span>{{ f.note }}</span></div>
          <div><span class="n">{{ f.n|num }}</span>{% if f.keep is not none %}<span class="keep">{{ "%.0f"|format(f.keep * 100) }}% of previous</span>{% endif %}</div>
        </li>
        {% endfor %}
      </ol>
      <p class="source">Source: SEC Insider Transactions Data Sets (83 quarters), SEC company ticker map, Yahoo Finance daily prices.</p>
    </article>
    <article class="card">
      <div class="card-head"><div>
        <h2>Highest-scored new events</h2>
        <p class="card-sub">Filed July–September 2026, scored by the pilot model.</p>
      </div></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Company</th><th>Type</th><th class="num">Value</th><th class="num">Score</th></tr></thead>
          <tbody>
          {% for r in v.top_recent %}
            <tr>
              <td class="co-cell"><button class="linkish" data-company="{{ r.cik }}"><span class="ticker">{{ r.ticker }}</span></button><span class="co-name">{{ r.name }}</span></td>
              <td><span class="chip {{ r.group|lower }}"><i></i>{{ "Cluster" if r.group == "A" else "CEO/CFO" }}</span></td>
              <td class="num">{{ r.value|money }}</td>
              <td class="num">{{ "%.0f"|format(r.score * 100) }}%</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p><button class="linkish" data-tab="screener">Open all {{ v.recent.total }} events in the screener →</button></p>
    </article>
  </div>
  <div class="grid three">
    <article class="card">
      <h2>Findings</h2>
      <p class="card-sub">How stocks moved from 20 trading days before to a year after insiders bought, against small caps and the S&amp;P 500.</p>
      <p><button class="linkish" data-tab="findings">See the return paths →</button></p>
    </article>
    <article class="card">
      <h2>Model</h2>
      <p class="card-sub">A logistic regression and a gradient-boosted model, tested on 2011 against a model that sees only market data.</p>
      <p><button class="linkish" data-tab="model">See how well it ranks →</button></p>
    </article>
    <article class="card">
      <h2>Company lookup</h2>
      <p class="card-sub">Every insider purchase and sale on Form 4 for {{ c.meta.companies|num }} companies, with their events and scores.</p>
      <p><button class="linkish" data-tab="company">Search a company →</button></p>
    </article>
  </div>
</section>

<!-- ============================== FINDINGS ============================== -->
<section id="findings" class="panel" role="tabpanel" aria-labelledby="tab-findings" hidden>
  <div class="panel-head">
    <p class="eyebrow">Event study · pilot sample 2006–2011</p>
    <h1>What happened after insiders bought</h1>
    <p class="lead">Each event is bought at the opening price on the first trading day after the Form 4 was filed. The abnormal return is the stock's return minus the benchmark's over the same days. Costs are a round-trip bid–ask spread estimated from each stock's daily high and low prices.</p>
  </div>
  {{ banner("Companies that failed or were acquired after 2011 are missing, which likely flatters these numbers.") }}
  <div class="kpis">
    <div class="kpi"><span class="kpi-label"><i class="dot" style="background:var(--s1)"></i>Clusters · 63-day net, mean</span><span class="kpi-value">{{ signed(v.a.net) }}</span><span class="kpi-sub">Median {{ v.a.median|pct }} · {{ "%.0f"|format(v.a.share * 100) }}% positive</span></div>
    <div class="kpi"><span class="kpi-label"><i class="dot" style="background:var(--s2)"></i>Solo CEO/CFO · 63-day net, mean</span><span class="kpi-value">{{ signed(v.b.net) }}</span><span class="kpi-sub">Median {{ v.b.median|pct }} · {{ "%.0f"|format(v.b.share * 100) }}% positive</span></div>
    <div class="kpi"><span class="kpi-label">Typical round-trip cost</span><span class="kpi-value">{{ v.cost_median|pct(2, False) }}</span><span class="kpi-sub">Median estimated spread, all used events</span></div>
    <div class="kpi"><span class="kpi-label">Events measured</span><span class="kpi-value">{{ v.used_total|num }}</span><span class="kpi-sub">{{ "%.0f"|format(v.coverage_share * 100) }}% of {{ v.pilot_total|num }} pilot events</span></div>
  </div>
  <article class="card">
    <div class="card-head">
      <div>
        <h2>Average abnormal return around the purchase</h2>
        <p class="card-sub">Trading days relative to entry. Left of the dashed line, the line shows how far the price was above the entry price: insiders tend to buy after a fall. Shaded bands are 95% intervals that resample whole months, so events in the same month move together.</p>
      </div>
      <div class="seg" role="group" aria-label="Benchmark">
        <button type="button" data-bench="iwm" aria-pressed="true">vs small caps (IWM)</button>
        <button type="button" data-bench="spy" aria-pressed="false">vs S&amp;P 500 (SPY)</button>
      </div>
    </div>
    <div class="chart tall" id="chart-path" role="img" aria-label="Line chart of average abnormal return from 20 days before to 252 days after entry, for clusters and solo CEO/CFO purchases"></div>
    <p class="source">{{ c.meta.label }}. Gross of costs; subtract the typical cost above for a net figure.</p>
    <button class="linkish" data-table-toggle="table-path">Show the numbers</button>
    <div class="table-wrap" id="table-path" hidden></div>
  </article>
  <article class="card">
    <div class="card-head"><div>
      <h2>Returns by holding period</h2>
      <p class="card-sub">Abnormal returns at five horizons, before and after costs, with 95% month-resampled bands.</p>
    </div></div>
    {% for bench, title in [("iwm", "vs small caps (IWM)"), ("spy", "vs S&P 500 (SPY)")] %}
    <div class="table-wrap" data-bench-table="{{ bench }}" {% if bench != "iwm" %}hidden{% endif %}>
      <table>
        <caption>{{ title }} · {{ c.meta.label }}</caption>
        <thead><tr><th>Group</th><th class="num">Days held</th><th class="num">Events</th><th class="num">Mean, gross</th><th class="num">Mean, net</th><th class="num">95% band (net)</th><th class="num">Median, net</th><th class="num">Share positive</th></tr></thead>
        <tbody>
        {% for row in v.horizon_rows[bench] %}
          <tr>
            <td><span class="chip {{ row.group|lower }}"><i></i>{{ "Clusters" if row.group == "A" else "Solo CEO/CFO" }}</span></td>
            <td class="num">{{ row.h }}</td>
            <td class="num">{{ row.n|num }}</td>
            <td class="num">{{ signed(row.gross) }}</td>
            <td class="num">{{ signed(row.net) }}</td>
            <td class="num">{{ row.lo|pct }} to {{ row.hi|pct }}</td>
            <td class="num">{{ signed(row.median) }}</td>
            <td class="num">{{ "%.0f"|format(row.share * 100) }}%</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endfor %}
  </article>
  <div class="grid two">
    <article class="card">
      <div class="card-head"><div>
        <h2>63-day net return by year</h2>
        <p class="card-sub">The 2009 rebound after the financial crisis carries most of the average.</p>
      </div></div>
      <div class="chart short" id="chart-years" role="img" aria-label="Bar chart of 63-day net abnormal return by year for clusters and solo CEO/CFO purchases"></div>
      <button class="linkish" data-table-toggle="table-years">Show the numbers</button>
      <div class="table-wrap" id="table-years" hidden></div>
    </article>
    <article class="card">
      <div class="card-head"><div>
        <h2>Who is in the sample</h2>
        <p class="card-sub">Only companies that still trade today can be priced from Yahoo. The full study adds delisted stocks.</p>
      </div></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Group</th><th class="num">Pilot events</th><th class="num">Still listed</th><th class="num">Priced</th><th class="num">Tradable</th><th class="num">Share kept</th></tr></thead>
          <tbody>
          {% for g, row in v.coverage %}
            <tr><td><span class="chip {{ g|lower }}"><i></i>{{ "Clusters" if g == "A" else "Solo CEO/CFO" }}</span></td>
            <td class="num">{{ row.events|num }}</td><td class="num">{{ row.listed|num }}</td><td class="num">{{ row.priced|num }}</td><td class="num">{{ row.used|num }}</td><td class="num">{{ "%.0f"|format(row.share * 100) }}%</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="card-sub">{% if v.coverage_share < 0.3 %}<strong>Low coverage.</strong> {% endif %}Roughly two in three pilot events are at companies that later failed, were acquired or were otherwise delisted. That is the survivorship bias the full study removes with delisted-stock prices.</p>
    </article>
  </div>
</section>

<!-- ============================== MODEL ============================== -->
<section id="model" class="panel" role="tabpanel" aria-labelledby="tab-model" hidden>
  <div class="panel-head">
    <p class="eyebrow">Machine learning · trained 2006–2010, tested on 2011</p>
    <h1>Can a model tell the good clusters from the bad?</h1>
    <p class="lead">Each model predicts whether an event's 63-day abnormal return against small caps, after costs, will be positive. It sees only what was known on the filing date: who bought, how much, how their holdings changed, recent insider selling, and the stock's recent trading.</p>
  </div>
  {{ banner("The model is trained on a small, survivors-only sample. Treat its scores as a demonstration of the method.") }}
  <div class="answer">
    <p class="eyebrow">Pilot verdict</p>
    <p class="verdict">{{ v.m.verdict }}</p>
    <p>{{ v.m.verdict_detail }}</p>
  </div>
  <div class="kpis">
    <div class="kpi"><span class="kpi-label">Selected model</span><span class="kpi-value" style="font-size:1.35rem">{{ v.m.selected_name }}</span><span class="kpi-sub">Lowest 2011 log loss of the two candidates</span></div>
    <div class="kpi"><span class="kpi-label">Ranking quality (AUC)</span><span class="kpi-value">{{ "%.2f"|format(v.m.auc) }}</span><span class="kpi-sub">Chance 0.50 · market-only {{ "%.2f"|format(v.m.base_auc) }}</span></div>
    <div class="kpi"><span class="kpi-label">Top fifth by score · 63-day net</span><span class="kpi-value">{{ signed(v.m.top5) }}</span><span class="kpi-sub">All 2011 events: {{ v.m.all|pct }}</span></div>
    <div class="kpi"><span class="kpi-label">Events used</span><span class="kpi-value">{{ v.m.n_train|num }}</span><span class="kpi-sub">training · {{ v.m.n_test|num }} test (2011)</span></div>
  </div>
  <article class="card">
    <div class="card-head"><div>
      <h2>Model comparison on 2011</h2>
      <p class="card-sub">Lower log loss and Brier score are better; a higher AUC means better ranking. The base-rate row predicts the training share of winners for every event.</p>
    </div></div>
    <div class="table-wrap">
      <table>
        <caption>{{ c.meta.label }}</caption>
        <thead><tr><th>Model</th><th>Sees</th><th class="num">AUC</th><th class="num">Log loss</th><th class="num">Brier</th><th class="num">Top-fifth hit rate</th><th class="num">Top-fifth net return</th></tr></thead>
        <tbody>
        {% for r in v.m.rows %}
          <tr>
            <td>{{ r.name }}{% if r.selected %} <span class="flag">selected</span>{% endif %}</td>
            <td class="muted">{{ r.sees }}</td>
            <td class="num">{{ "%.3f"|format(r.auc) if r.auc is not none else "–" }}</td>
            <td class="num">{{ "%.3f"|format(r.log_loss) }}</td>
            <td class="num">{{ "%.3f"|format(r.brier) }}</td>
            <td class="num">{{ ("%.0f"|format(r.hit * 100) ~ "%") if r.hit is not none else "–" }}</td>
            <td class="num">{{ signed(r.top5) if r.top5 is not none else "–" }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </article>
  <div class="grid two">
    <article class="card">
      <div class="card-head"><div>
        <h2>Do the probabilities mean what they say?</h2>
        <p class="card-sub">Predicted chance of a positive net return against the share that actually came out positive, in five equal-sized groups of 2011 events. The dashed line is perfect calibration.</p>
      </div></div>
      <div class="chart" id="chart-calibration" role="img" aria-label="Calibration chart comparing predicted and observed rates for the selected model and the market-only model"></div>
      <button class="linkish" data-table-toggle="table-calibration">Show the numbers</button>
      <div class="table-wrap" id="table-calibration" hidden></div>
    </article>
    <article class="card">
      <div class="card-head"><div>
        <h2>What drives the score</h2>
        <p class="card-sub">How much worse the selected model predicts 2011 when each input is shuffled (permutation importance). Longer bars matter more.</p>
      </div></div>
      <div class="chart" id="chart-drivers" role="img" aria-label="Bar chart of permutation importance for the top model inputs"></div>
      <button class="linkish" data-table-toggle="table-drivers">Show the numbers</button>
      <div class="table-wrap" id="table-drivers" hidden></div>
    </article>
  </div>
  <article class="card">
    <h2>How the model was built</h2>
    <dl class="defs">
      <dt>Outcome</dt><dd>1 if the 63-day abnormal return against IWM, after the estimated round-trip cost, is above zero; otherwise 0. Base rate {{ "%.0f"|format(v.m.base_rate * 100) }}%.</dd>
      <dt>Training</dt><dd>{{ v.m.n_train|num }} events from {{ v.m.train_years[0] }}–{{ v.m.train_years[1] }} whose 63-day window ended before 2011 (purged, so no training outcome overlaps the test year).</dd>
      <dt>Test</dt><dd>{{ v.m.n_test|num }} events from {{ v.m.test_year }}, scored once.</dd>
      <dt>Candidates</dt><dd>Regularised logistic regression (median imputation, missing-value flags, standardised inputs) and LightGBM (small fixed settings, no tuning).</dd>
      <dt>Baseline</dt><dd>The selected family trained on market data only: liquidity, recent returns, momentum, distance from the 52-week high, volatility and spread.</dd>
      <dt>Live scores</dt><dd>The selected model, refitted on all {{ v.m.n_all|num }} pilot events, scores the Jul–Sep 2026 events using only data up to each filing date. No outcome is computed for any event after 2011.</dd>
    </dl>
  </article>
</section>

<!-- ============================== SCREENER ============================== -->
<section id="screener" class="panel" role="tabpanel" aria-labelledby="tab-screener" hidden>
  <div class="panel-head">
    <p class="eyebrow">Screener · filed {{ c.meta.recent[0] }} to {{ c.meta.recent[1] }}</p>
    <h1>Latest insider clusters</h1>
    <p class="lead">Every cluster and solo CEO/CFO purchase in the newest quarter of SEC data, scored by the pilot model. The score is the predicted chance of beating small caps over the next 63 trading days after costs; the percentile compares it with all pilot events.</p>
  </div>
  {{ banner("Scores come from a weak, survivors-only pilot model and are not investment advice. No outcome is shown for these events.") }}
  <div class="filters" role="search">
    <div class="field"><label for="f-group">Type</label>
      <select id="f-group"><option value="all">All types</option><option value="A">Clusters</option><option value="B1">Solo CEO/CFO</option></select></div>
    <div class="field"><label for="f-score">Minimum score</label>
      <select id="f-score"><option value="0">Any score</option><option value="0.5">50% or more</option><option value="0.55">55% or more</option><option value="0.6">60% or more</option></select></div>
    <div class="field"><label for="f-value">Minimum value</label>
      <select id="f-value"><option value="0">Any value</option><option value="250000">$250k or more</option><option value="1000000">$1M or more</option><option value="5000000">$5M or more</option></select></div>
    <div class="field" style="flex:1;min-width:180px"><label for="f-text">Company or ticker</label>
      <input id="f-text" type="search" placeholder="e.g. bank, AAPL" autocomplete="off"></div>
    <span class="count" id="screener-count" aria-live="polite">{{ c.screener|length }} events</span>
  </div>
  <div class="table-wrap">
    <table id="screener-table">
      <thead><tr>
        <th class="sortable" data-sort="date" aria-sort="descending">Filed</th>
        <th class="sortable" data-sort="name">Company</th>
        <th class="sortable" data-sort="group">Type</th>
        <th class="sortable num" data-sort="insiders">Insiders</th>
        <th class="sortable num" data-sort="value">Value</th>
        <th>Roles</th>
        <th class="sortable" data-sort="score">Score</th>
        <th class="sortable num" data-sort="pct">Pilot percentile</th>
      </tr></thead>
      <tbody id="screener-body">
      {% for r in c.screener %}
        <tr>
          <td class="mono">{{ r.date }}</td>
          <td class="wrap-cell"><button class="linkish" data-company="{{ r.cik }}"><span class="ticker">{{ r.ticker or "—" }}</span></button> {{ r.name }}</td>
          <td><span class="chip {{ r.group|lower }}"><i></i>{{ "Cluster" if r.group == "A" else "Solo CEO/CFO" }}</span></td>
          <td class="num">{{ r.insiders }}</td>
          <td class="num">{{ r.value|money }}</td>
          <td class="muted">{{ r.roles }}</td>
          <td>{% if r.g8_fail %}<span class="muted">price check failed</span>{% elif r.score is not none %}<span class="scorebar"><span class="track"><span class="fill" style="width:{{ (r.score * 100)|round(0) }}%"></span></span><span>{{ "%.0f"|format(r.score * 100) }}%</span></span>{% if r.partial %}<span class="flag">partial data</span>{% endif %}{% else %}<span class="muted">not priced</span>{% endif %}</td>
          <td class="num">{{ ("%.0f"|format(r.pct * 100) ~ "th") if r.pct is not none else "–" }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="source">{{ c.meta.g7_excluded }} events at funds, business development companies and blank-check companies are left out (gate G7: EDGAR gives them a fund or blank-check industry code, or none). Events without a score are at companies no longer in the SEC's list of traded companies, so no recent prices exist for them, or failed the price check (a reported purchase price outside that day's trading range, usually a filing typo). "Partial data" means four or more model inputs were missing.</p>
</section>

<!-- ============================== COMPANY ============================== -->
<section id="company" class="panel" role="tabpanel" aria-labelledby="tab-company" hidden>
